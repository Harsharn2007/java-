class BankAccount {
    int accNo;
    String name;
    double balance;
}

public class Main {
    public static void main(String[] args) {

        BankAccount b1 = new BankAccount();

        b1.accNo = 101;
        b1.name = "Harsharn";
        b1.balance = 5000;

        System.out.println("Account Number: " + b1.accNo);
        System.out.println("Name: " + b1.name);
        System.out.println("Balance: " + b1.balance);
    }
}
